# ── Modo de ejecución del frontend ─────────────────────────────────────────────
# true  → datos de demostración locales (sin backend). Es el valor por defecto.
# false → consume los microservicios reales vía el gateway API y el BFF.
NEXT_PUBLIC_MOCK=true

# ── Base del gateway API (solo relevante con NEXT_PUBLIC_MOCK=false) ───────────
# Si se deja vacío, el navegador habla con el mismo origen y Next.js reenvía
# /api/* al gateway y /api/bff/* al BFF mediante rewrites (ver next.config.mjs).
# Si se define, las llamadas van directo a esa base por CORS.
NEXT_PUBLIC_API_BASE=http://localhost:8080